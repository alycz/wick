{
  "name": "wick",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint && tsc -p tsconfig.json --noEmit",
    "test": "pnpm -r --if-present test && vitest run scripts/tests",
    "test:anchor:local": "node --import tsx --test --test-concurrency=1 tests/anchor/*.anchor.test.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "collector": "node --import tsx scripts/sol-collector.ts",
    "create:mint": "node --import tsx scripts/create-mint.ts",
    "create:stream": "node --import tsx scripts/create-stream.ts",
    "deploy:program": "node --import tsx scripts/deploy.ts",
    "deploy:check": "node --import tsx scripts/deployment-check.ts",
    "deploy:verify": "node --import tsx scripts/verify-deployment.ts",
    "sync:idl": "node --import tsx scripts/sync-idl.ts",
    "init:config": "node --import tsx scripts/init-config.ts",
    "airdrop": "node --import tsx scripts/airdrop.ts",
    "bots": "node --import tsx scripts/bots.ts",
    "demo:check": "node --import tsx scripts/demo-check.ts",
    "demo:record": "node --import tsx scripts/record-demo.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vitest": "3.2.7",
    "playwright": "1.56.1"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "zod": "3.25.76"
  }
}
