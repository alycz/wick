{
  "name": "wick",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint && tsc -p tsconfig.json --noEmit",
    "test": "pnpm -r --if-present test",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "collector": "node --import tsx scripts/sol-collector.ts",
    "create:mint": "node --import tsx scripts/create-mint.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "zod": "3.25.76"
  }
}
